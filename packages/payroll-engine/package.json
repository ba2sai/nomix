{
  "name": "@nomix/payroll-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de cálculo de nómina de Panamá. Puro: sin I/O, sin base de datos, sin reloj.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
