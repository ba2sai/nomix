{
  "name": "@nomix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Nomix (NestJS + Fastify). REST + SSE. Única autoridad de cálculo.",
  "scripts": {
    "dev": "tsc -w -p tsconfig.json & node --watch dist/main.js",
    "start": "node dist/main.js",
    "seed": "node dist/seed.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nomix/contracts": "workspace:*",
    "@nomix/db": "workspace:*",
    "@nomix/payroll-engine": "workspace:*",
    "@nomix/rules": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
