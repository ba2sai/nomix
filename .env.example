# === Nomix — variables de entorno (plantilla) ===
# Copia este archivo a .env y completa los valores. NUNCA commitees .env.

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nomix
POSTGRES_USER=nomix
POSTGRES_PASSWORD=cambia_esto_en_local
# La app se conecta con un rol SIN BYPASSRLS (ver ADR-011 / seguridad-datos)
DATABASE_URL=postgresql://nomix_app:cambia_esto@localhost:5432/nomix

# --- Redis (sesiones, cache, colas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Cifrado de campos PII (ADR-007) ---
# Clave AES-256-GCM para cedula y cuenta_bancaria. 32 bytes en base64.
# salario_base NO se cifra (ADR-007). Genera con: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Sesión ---
SESSION_SECRET=cambia_esto
SESSION_TTL_SECONDS=28800

# --- Respaldos (ADR-012) — se completan en staging/prod, no en dev ---
# PGBACKREST_REPO1_S3_BUCKET=
# PGBACKREST_REPO1_S3_ENDPOINT=
# PGBACKREST_REPO1_CIPHER_PASS=

# --- Documentos de colaboradores (ADR-022) ---
# Contratos y cédulas escaneadas. Apunta a un directorio DENTRO del volumen que
# entra al respaldo: el default cae dentro del repo, que sirve para desarrollo
# pero no sobrevive a un redespliegue.
DOCUMENTOS_DIR=/var/lib/nomix/documentos
