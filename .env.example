# Solo desarrollo local. Los secretos vacios se generan con make env o .\nomix.ps1 env.
COMPOSE_PROJECT_NAME=nomix
APP_ENV=local
APP_DEBUG=false
APP_KEY=
API_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025
POSTGRES_DB=nomix
POSTGRES_USER=nomix_admin
POSTGRES_PASSWORD=
DB_USERNAME=nomix_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=nomix_migrator
DB_MIGRATION_PASSWORD=
# Docker Desktop / Windows: activar si el editor no dispara eventos de archivos.
VITE_USE_POLLING=false
