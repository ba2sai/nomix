{
    "name": "nomix/backend",
    "type": "project",
    "description": "API de Nomix",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-bcmath": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "brick/math": "^1.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "format": "pint",
        "lint": [
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G",
            "phpstan analyse --no-progress --memory-limit=1G --configuration=phpstan-domain.neon"
        ],
        "test": "pest",
        "mutate": "pest --mutate --parallel --testsuite=Unit --min=100",
        "coverage": "pest --configuration=phpunit.domain.xml --coverage --min=100"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
