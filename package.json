{
  "name": "nomix",
  "version": "0.1.0",
  "private": true,
  "description": "Nomix — Nómina inteligente para Panamá",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @nomix/db db:generate",
    "db:migrate": "pnpm --filter @nomix/db db:migrate",
    "infra:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "eslint": "^9.11.0",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.0",
    "vitest": "^2.1.0"
  }
}
